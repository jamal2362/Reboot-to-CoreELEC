<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/button_stroke">
    <item>
        <selector>
            <item android:state_focused="true">
                <shape android:shape="rectangle">
                    <solid android:color="@color/button_fill_focused" />
                    <corners android:radius="24dp" />
                    <stroke
                        android:width="3dp"
                        android:color="@color/button_stroke_focused" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/button_fill" />
                    <corners android:radius="24dp" />
                    <stroke
                        android:width="2dp"
                        android:color="@color/button_stroke" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
